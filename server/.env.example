# CareLittle AI Backend - Environment Configuration Example
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb://localhost:27017/carelittle_dev

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
CLERK_SECRET_KEY=sk_test_placeholder_key

# Country-Specific Configuration (Default: IN for India)
DEFAULT_COUNTRY_CODE=IN

# AI Provider Configuration (OpenRouter - Phase 4)
DEFAULT_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=CareLittle AI
